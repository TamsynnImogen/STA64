#!/usr/bin/env bash
# run-gated: run the install-gated tests of every crate, one group (kind of install) at a time, before a release.
# See docs/GATED_TESTS.md. Not used by CI (CI has no installs).
#
#   tools/run-gated [--list] [--gpu] [--group NAME]... [--dry-run]
#
# The install paths come from tools/gated.local (git-ignored; copy tools/gated.example and fill it in): lines of
# NAME=value, read as text, never sourced. Nothing from a machine goes into the repository.
#
#   --list        the self-check: which groups have a path set and whether the folder exists; runs nothing
#   --gpu         also set STA64_GPU_TESTS=1 (the GPU opt-in tests; off unless asked)
#   --group NAME  only this group (first-game, stock-second, mod-family, fo327, dominion-war, evolution); repeatable
#   --dry-run     print the cargo command of each group and run nothing
#
# Each group runs `tools/agent-cargo test --workspace` once with only that group's variables set (through cargo's
# `--config env.NAME=...` form), filtered to the tests whose name contains "install" (the naming convention of a gated
# test), so the tests of the other groups skip with their one-line message. One build at a time: agent-cargo holds its
# locks. The tests write only to temporary folders and never launch a game.
#
# Per group it prints: passed, failed, skipped. A skipped test prints `SKIP: ...` once and then counts as passed for
# libtest, so skipped is the number of SKIP lines and passed is the libtest ok count minus them.
set -u

here="$(cd "$(dirname "$0")" && pwd)"
repo="$(dirname "$here")"
local_file="${STA64_GATED_FILE:-$here/gated.local}"

# group  variables (the root first, then the mod's)
groups=(first-game stock-second mod-family fo327 dominion-war evolution)
roots_of() {
  case "$1" in
    first-game) echo STA64_TEST_A1_INSTALL ;;
    stock-second) echo STA64_TEST_A2_STOCK_INSTALL ;;
    mod-family) echo STA64_TEST_ROOTS_INSTALL ;;
    fo327) echo STA64_TEST_FO327_INSTALL ;;
    dominion-war) echo STA64_TEST_DW_INSTALL ;;
    evolution) echo STA64_TEST_EVOLUTION_INSTALL ;;
  esac
}
mod_of() {
  case "$1" in
    mod-family) echo STA64_TEST_ROOTS_MOD ;;
  esac
}

list=0 gpu=0 dry=0
only=()
while [ $# -gt 0 ]; do
  case "$1" in
    --list) list=1 ;;
    --gpu) gpu=1 ;;
    --dry-run) dry=1 ;;
    --group) shift; only+=("${1:-}") ;;
    -h|--help) sed -n '2,24p' "$0"; exit 0 ;;
    *) echo "run-gated: unknown argument $1" >&2; exit 2 ;;
  esac
  shift
done

# NAME=value lines of the local file, as text.
declare -A val
if [ -f "$local_file" ]; then
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in ''|'#'*) continue ;; esac
    name="${line%%=*}"
    [ "$name" = "$line" ] && continue
    v="${line#*=}"
    v="${v#\"}"; v="${v%\"}"
    val[$name]="$v"
  done < "$local_file"
fi

selected=()
for g in "${groups[@]}"; do
  if [ ${#only[@]} -gt 0 ]; then
    keep=0
    for o in "${only[@]}"; do [ "$o" = "$g" ] && keep=1; done
    [ $keep -eq 1 ] || continue
  fi
  selected+=("$g")
done
for o in "${only[@]:-}"; do
  [ -z "$o" ] && continue
  ok=0
  for g in "${groups[@]}"; do [ "$g" = "$o" ] && ok=1; done
  [ $ok -eq 1 ] || { echo "run-gated: no group named $o" >&2; exit 2; }
done

if [ $list -eq 1 ]; then
  if [ ! -f "$local_file" ]; then
    echo "no local file: copy tools/gated.example to tools/gated.local and fill it in"
  fi
  for g in "${selected[@]}"; do
    var="$(roots_of "$g")"
    path="${val[$var]:-}"
    if [ -z "$path" ]; then
      printf '%-14s %-30s not set\n' "$g" "$var"
    elif [ -d "$path" ]; then
      printf '%-14s %-30s set, folder exists\n' "$g" "$var"
    else
      printf '%-14s %-30s set, FOLDER MISSING\n' "$g" "$var"
    fi
  done
  exit 0
fi

failed_groups=0
ran=0
for g in "${selected[@]}"; do
  var="$(roots_of "$g")"
  path="${val[$var]:-}"
  if [ -z "$path" ]; then
    printf '%-14s not set (%s): skipped\n' "$g" "$var"
    continue
  fi
  if [ ! -d "$path" ]; then
    printf '%-14s folder missing (%s): skipped\n' "$g" "$var"
    continue
  fi
  config=(--config "env.$var=\"$path\"")
  modvar="$(mod_of "$g")"
  if [ -n "$modvar" ] && [ -n "${val[$modvar]:-}" ]; then
    config+=(--config "env.$modvar=\"${val[$modvar]}\"")
  fi
  if [ $gpu -eq 1 ]; then
    config+=(--config 'env.STA64_GPU_TESTS="1"')
  fi
  cmd=("$here/agent-cargo" test --locked --workspace --no-fail-fast "${config[@]}" -- install --nocapture)
  if [ $dry -eq 1 ]; then
    printf '%-14s ' "$g"; printf '%q ' "${cmd[@]}" | sed "s|$path|<path>|g"; echo
    continue
  fi
  out="$(mktemp "${TMPDIR:-/tmp}/run-gated.XXXXXX")"
  ( cd "$repo" && "${cmd[@]}" ) > "$out" 2>&1
  status=$?
  oks=$(grep -c '^test .* \.\.\. ok$' "$out")
  fails=$(grep -c '^test .* \.\.\. FAILED$' "$out")
  skips=$(grep -c '^SKIP' "$out")
  passed=$((oks - skips)); [ $passed -lt 0 ] && passed=0
  printf '%-14s passed %-4d failed %-4d skipped %-4d\n' "$g" "$passed" "$fails" "$skips"
  if [ $fails -gt 0 ] || { [ $status -ne 0 ] && [ $oks -eq 0 ]; }; then
    failed_groups=$((failed_groups + 1))
    grep -E '^test .* \.\.\. FAILED$|^error' "$out" | sort -u | sed 's/^/    /' | head -40
    echo "    full output: $out"
  else
    rm -f "$out"
  fi
  ran=$((ran + 1))
done

[ $dry -eq 1 ] && exit 0
echo "groups run: $ran, groups with failures: $failed_groups"
[ $failed_groups -eq 0 ]
